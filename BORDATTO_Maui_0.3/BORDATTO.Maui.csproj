<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>BordattoStudio</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiVersion>10.0.101</MauiVersion>
    <ApplicationTitle>BORDATTO Studio</ApplicationTitle>
    <ApplicationId>com.bordatto.app</ApplicationId>
    <ApplicationDisplayVersion>0.3.4</ApplicationDisplayVersion>
    <ApplicationVersion>45</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#0B0807" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0B0807" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.152.0" />
  </ItemGroup>
</Project>
